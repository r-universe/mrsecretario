[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "textileFlame"]
	path = textileFlame
	url = https://github.com/cran/textileFlame
[submodule "weaveCompare"]
	path = weaveCompare
	url = https://github.com/cran/weaveCompare
[submodule "weaveDraft"]
	path = weaveDraft
	url = https://github.com/cran/weaveDraft
